# Backend environment variables — copy to .env and fill in values
# Do NOT commit .env to version control

# Model identifier (HuggingFace model ID)
MODEL_ID=hamzab/roberta-fake-news-classification

# Inference device: "cpu" or "cuda"
INFERENCE_DEVICE=cpu

# SHAP explanation: max evaluations (higher = richer but slower)
SHAP_MAX_EVALS=100

# CORS: comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
